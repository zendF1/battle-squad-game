; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="battle-squad-game"
run/main_scene="res://screens/splash.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/branding/icon/app_icon_macos.png"
boot_splash/bg_color=Color(0.604, 0.851, 0.945, 1)
boot_splash/image="res://assets/branding/splash.png"
boot_splash/stretch_mode=4

[autoload]

Config="*res://autoload/config.gd"
Session="*res://autoload/session.gd"
Api="*res://autoload/api.gd"
PlayerState="*res://autoload/player_state.gd"
GuildState="*res://autoload/guild_state.gd"
GameSocket="*res://autoload/game_socket.gd"
Router="*res://autoload/router.gd"

[battle_squad]

api_url="http://localhost:9090"
ws_url="ws://localhost:9091"
terms_url="https://battlesquad.chuongnguyen.online/terms"
privacy_url="https://battlesquad.chuongnguyen.online/privacy"
google_client_id_ios="766073933747-o6hvrdm7gm1pm0t45h9f8009fbid28ju.apps.googleusercontent.com"
google_client_id_macos="766073933747-dsc8mca1ukqsqlk2v8faarr1md1jipj0.apps.googleusercontent.com"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[debug]

file_logging/enable_file_logging.ios=true
